CREATE TABLE Comentarios (
    ID_DEL_COMENTARIO INT PRIMARY KEY,
    BAR_ID INT NOT NULL,
    E_MAIL VARCHAR(100) NOT NULL,
    NOMBRE_DE_LA_PERSONA_QUE_COMENTA VARCHAR(100) NOT NULL,
    FECHA DATE NOT NULL,
    TEXTO TEXT,
    Calificacion INT CHECK (Calificacion >= 1 AND Calificacion <= 5)
);

